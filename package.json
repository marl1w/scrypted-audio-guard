{
  "name": "@marl1w/scrypted-audio-guard",
  "version": "0.2.1",
  "description": "Scrypted plugin that turns a camera's audio into a standard AudioSensor: on when a sound rises clearly above the camera's own background, off in silence or steady noise.",
  "license": "MIT",
  "scripts": {
    "scrypted-setup-project": "scrypted-setup-project",
    "prescrypted-setup-project": "scrypted-package-json",
    "build": "scrypted-webpack",
    "prepublishOnly": "NODE_ENV=production scrypted-webpack",
    "scrypted-deploy": "scrypted-deploy",
    "scrypted-deploy-debug": "scrypted-deploy-debug",
    "scrypted-debug": "scrypted-debug",
    "scrypted-package-json": "scrypted-package-json",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test out-test/test/*.test.js"
  },
  "keywords": [
    "scrypted",
    "plugin",
    "audio",
    "sound",
    "audiosensor"
  ],
  "scrypted": {
    "rollup": true,
    "name": "Audio Guard",
    "type": "API",
    "interfaces": [
      "Settings",
      "MixinProvider"
    ],
    "pluginDependencies": []
  },
  "dependencies": {
    "@scrypted/sdk": "^0.5.59"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "terser-webpack-plugin": "^5.6.1",
    "typescript": "^5.6.0"
  },
  "author": "marl1w",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/marl1w/scrypted-audio-guard.git"
  },
  "homepage": "https://github.com/marl1w/scrypted-audio-guard#readme",
  "bugs": {
    "url": "https://github.com/marl1w/scrypted-audio-guard/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "README.md",
    "LICENSE",
    "package.json"
  ]
}
